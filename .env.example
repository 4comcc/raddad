# PostgreSQL connection string (Vercel Postgres / Neon / Supabase ...)
DATABASE_URL="postgresql://postgres@localhost:5432/raddad"

# Admin login for the platform owner (sees all businesses)
ADMIN_PASSWORD="change-me"
# Long random string used to sign session cookies (openssl rand -hex 32)
SESSION_SECRET="replace-with-64-random-hex-chars"

# Claude API — leave empty to run in demo mode (rule-based replies)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"

# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp)
# Token you choose; paste the same value in Meta's webhook settings
WA_VERIFY_TOKEN="choose-a-verify-token"
# App secret (App settings > Basic) — used to verify webhook signatures
WA_APP_SECRET=""
WA_GRAPH_VERSION="v21.0"
